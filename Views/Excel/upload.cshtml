@model List<DailyClientMeet.Models.ServiceRequest>

@{
    ViewData["Title"] = "Upload Service Data";
}

<div class="container-fluid">

    <div class="card shadow mb-4">

        <div class="card-header bg-primary text-white">

            <h4 class="mb-0">
                Upload Service Request Excel
            </h4>

        </div>

        <div class="card-body">

            <form method="post"
                  enctype="multipart/form-data">

                <div class="row">

                    <div class="col-md-8">

                        <input type="file"
                               name="excelFile"
                               class="form-control" />

                    </div>

                    <div class="col-md-4">

                        <button class="btn btn-success">

                            Upload Excel

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="mt-4">

        @foreach (var item in Model)
        {
            var color = item.Status.ToLower() == "closed"
            ? "#d4edda"
            : item.Status.ToLower() == "open"
            ? "#fff3cd"
            : "#d1ecf1";

            <div class="service-card mb-3"
                 style="
                 background:@color;
                 border-left:8px solid #007bff;
                 padding:15px;
                 border-radius:10px;
                 position:relative;">

                <div style="
                     position:absolute;
                     top:10px;
                     right:15px;">

                    <a asp-action="Delete"
                       asp-route-id="@item.SrNo"
                       class="text-danger">

                        <i class="fas fa-trash"></i>

                    </a>

                </div>

                <div class="row">

                    @* <div class="col-md-2">

                        <strong>Sr No</strong>

                        <div>@item.SrNo</div>

                    </div> *@

                    <div class="col-md-2">

                        <strong>ICT ID</strong>

                        <div>@item.ICTId</div>

                    </div>

                    <div class="col-md-2">

                        <strong>Created</strong>

                        <div>
                            @item.CreatedDate.ToString("dd-MMM-yyyy")
                        </div>

                    </div>

                    <div class="col-md-2">

                        <strong>Business POC</strong>

                        <div>
                            @item.BusinessPOC
                        </div>

                    </div>

                    <div class="col-md-2">

                        <strong>Status</strong>

                        <div>

                            @if (item.Status == "Open")
                            {
                                <span class="badge bg-warning">
                                    Open
                                </span>
                            }
                            else if (item.Status == "Closed")
                            {
                                <span class="badge bg-success">
                                    Closed
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-info">
                                    @item.Status
                                </span>
                            }

                        </div>

                    </div>

                </div>

                <hr />

                <div>

                    <strong>Description</strong>

                    <div>

                        @item.Description

                    </div>

                </div>

            </div>
        }

    </div>

</div>
